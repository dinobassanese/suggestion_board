# Private settings for the feature board.
# 1. Make a COPY of this file and name the copy exactly:  .env
# 2. Replace the example values after the = signs with your own.
# 3. Save, then restart the app (npm start).
# No spaces around the = sign, and no quotes.
# NEVER share the .env file or put it online: it holds your secrets.

# Cloudflare Turnstile (the "verify you are human" check). Needs BOTH keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The password for the staff dashboard (admin.html).
# ADMIN_PASSWORD=choose-a-long-password

# ---- Daily summary email (optional) ----
# OPTION A (recommended; works on Railway). Sends through Resend (resend.com):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DIGEST_FROM=Feature Board <feedback@yourcompany.com>   (must be on a domain verified in Resend)
# DIGEST_TO=you@yourcompany.com
#
# OPTION B: SMTP (some hosts block this). Needs the first four of these lines:
# SMTP_HOST=smtp.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=notifications@yourcompany.com
# SMTP_PASS=the-email-password-or-app-password
# DIGEST_TO=you@yourcompany.com          (several allowed: a@x.com,b@x.com)
# DIGEST_FROM=notifications@yourcompany.com   (optional)
# DIGEST_HOUR=8                          (0-23, default 8)
# DIGEST_TIMEZONE=America/Toronto        (default UTC; use YOUR time zone)
# PUBLIC_URL=https://feedback.yourcompany.com   (for the dashboard link)
